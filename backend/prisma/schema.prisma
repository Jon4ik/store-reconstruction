// Prisma Schema для системы "Реконструкция — Закрытие"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  fullName     String
  theme        String   @default("light")
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  comments     Comment[]
  auditLogs    AuditLog[]
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  users       User[]
  @@map("roles")
}

model TU {
  id        String   @id @default(uuid())
  fullName  String
  position  String   @default("Территориальный управляющий")
  phone     String?
  email     String?
  adObjectGuid String? @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  StoreProject[]
  @@map("tus")
}

model LdapSettings {
  id                    String   @id @default("default")
  url                   String   @default("")
  baseDN                String   @default("")
  bindDN                String   @default("")
  bindPasswordEncrypted String   @default("")
  updatedAt             DateTime @updatedAt
  @@map("ldap_settings")
}


model IntegrationSettings {
  id                     String   @id @default("default")
  intraDeskEnabled       Boolean  @default(false)
  intraDeskApiGateway    String   @default("")
  intraDeskApiKeyEncrypted String @default("")
  pachcaEnabled          Boolean  @default(false)
  pachcaApiGateway       String   @default("https://api.pachca.com/api/shared/v1")
  pachcaApiKeyEncrypted  String   @default("")
  smtpEnabled            Boolean  @default(false)
  smtpHost               String   @default("")
  smtpPort               Int      @default(587)
  smtpSecure             Boolean  @default(false)
  smtpUser               String   @default("")
  smtpPasswordEncrypted  String   @default("")
  smtpFromEmail          String   @default("")
  smtpFromName           String   @default("")
  updatedAt              DateTime @updatedAt
  @@map("integration_settings")
}

model ShopDirectory {
  id              String   @id @default(uuid())
  shopNumber      String   @unique
  city            String   @default("")
  address         String
  workHours       String   @default("")
  areaManager     String   @default("")
  areaManagerPhone String  @default("")
  tu              String   @default("")
  directorate     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([city])
  projects        StoreProject[]
  @@map("shop_directory")
}

model SchedulerTask {
  id             String   @id
  name           String
  cronExpression String   @default("0 0 * * *")
  enabled        Boolean  @default(true)
  lastRunAt      DateTime?
  lastStatus     String   @default("never")
  lastMessage    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("scheduler_tasks")
}

model StoreProject {
  id               String    @id @default(uuid())
  storeNumber      String
  shop             ShopDirectory @relation(fields: [storeNumber], references: [id])
  workType         String
  closureDate      DateTime?
  demolitionDate   DateTime?
  installationDate DateTime?
  techOpenDate     DateTime?
  tuId             String
  tu               TU        @relation(fields: [tuId], references: [id])
  rowColor         String    @default("")
  comment          String    @default("")
  status           String    @default("Запланирован")
  manualStatus     String?
  stageTasks       Json      @default("{}")
  isDeleted        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String
  comments         Comment[]
  auditLogs        AuditLog[]
  @@map("store_projects")
}

model Comment {
  id        String   @id @default(uuid())
  storeId   String
  store     StoreProject @relation(fields: [storeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  userName  String
  text      String
  createdAt DateTime @default(now())
  @@index([storeId])
  @@map("comments")
}

model AuditLog {
  id        String   @id @default(uuid())
  storeId   String?
  store     StoreProject? @relation(fields: [storeId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String
  timestamp DateTime @default(now())
  action    String
  field     String
  oldValue  String   @default("")
  newValue  String   @default("")
  details   String   @default("")
  @@index([userId])
  @@index([storeId])
  @@index([timestamp])
  @@map("audit_logs")
}


model NotificationRule {
  id               String   @id @default(uuid())
  name             String
  offsetType       String
  eventType        String
  days             Int
  channel          String
  enabled          Boolean  @default(true)
  sendTime         String   @default("09:00")
  messageTemplate  String   @db.Text
  intradeskGroup   String   @default("")
  intradeskService String   @default("")
  intradeskSubject String   @default("")
  intradeskTaskType String  @default("")
  intradeskTags     String   @default("")
  pachcaTargetType  String   @default("channel")
  pachcaEntityId    String   @default("")
  pachcaRecipientId String   @default("")
  emailTo           String   @default("")
  emailSubject      String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deliveries       NotificationDelivery[]
  @@index([enabled, eventType])
  @@map("notification_rules")
}

model NotificationDelivery {
  id        String   @id @default(uuid())
  ruleId    String
  rule      NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  projectId String
  eventDate DateTime
  status    String   @default("sent")
  message   String   @default("") @db.Text
  requestNumber String @default("")
  sentAt    DateTime @default(now())
  @@unique([ruleId, projectId, eventDate])
  @@index([sentAt])
  @@map("notification_deliveries")
}
