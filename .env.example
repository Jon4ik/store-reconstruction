# ============================================
# Конфигурация системы "Реконструкция — Закрытие"
# ============================================

# PostgreSQL (внешняя база данных)
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=store_reconstruction
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Backend
NODE_ENV=production
API_PORT=4000

# Domain (для SSL и CORS)
DOMAIN=https://reconstruction.yourcompany.ru

# Email notifications (опционально)
SMTP_HOST=smtp.yourcompany.ru
SMTP_PORT=587
SMTP_USER=noreply@yourcompany.ru
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM=Реконструкция <noreply@yourcompany.ru>

# Set once to bootstrap the first admin, then remove this variable after seeding.
BOOTSTRAP_ADMIN_PASSWORD=
# Optional demo users for non-production environments only.
SEED_DEMO_USERS=false
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_VIEWER_PASSWORD=

# SQL Server source for the shop directory (secrets stay in the backend environment)
UKM_SQL_SERVER=your-sql-server-host
UKM_SQL_PORT=1433
UKM_SQL_DATABASE=Ukm_Data
UKM_SQL_USER=your_readonly_user
UKM_SQL_PASSWORD=change_me
UKM_SQL_VIEW=[Ukm_Data].[dbo].[v_1C_Shops_Info]
PYTHON_EXECUTABLE=python3
